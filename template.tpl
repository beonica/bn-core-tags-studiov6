___TESTS___

scenarios:
- name: Primeira execução em produção
  code: |-
    runCode(input);

    assertApi('createArgumentsQueue').wasCalledWith('beon', 'beon.q');

    assertThat(commands).isEqualTo([
      ['create', 'tenant-teste', 'vtex']
    ]);

    assertThat(globals.beonConfig.cookieDomain).isEqualTo(input.cookieDomain);

    assertThat(loads).isEqualTo([{
      url: 'https://c.usebeon.io/v6/loader.js',
      cacheToken: 'https://c.usebeon.io/v6/loader.js'
    }]);

    assertApi('gtmOnSuccess').wasCalled();
    assertApi('gtmOnFailure').wasNotCalled();
- name: Ambiente staging
  code: |-
    input.env = 'staging';

    runCode(input);

    assertThat(globals.beonConfig.env).isEqualTo('staging');

    assertThat(loads).isEqualTo([{
      url: 'https://c.staging.usebeon.io/v6/loader.js',
      cacheToken: 'https://c.staging.usebeon.io/v6/loader.js'
    }]);

    assertApi('gtmOnSuccess').wasCalled();
    assertApi('gtmOnFailure').wasNotCalled();
- name: Runtime já inicializada com a mesma configuração
  code: |-
    globals['beonly._coreVersion'] = 6;
    globals['beonly.inited'] = true;
    globals['beonly.account'] = input.accountId;
    globals['beonly.platform'] = input.platform;
    globals['beonly.env'] = input.env;
    globals['beonly.cookiedomain'] = input.cookieDomain;

    runCode(input);

    assertThat(commands).isEmpty();
    assertThat(loads).isEmpty();
    assertApi('setInWindow').wasNotCalled();
    assertApi('gtmOnSuccess').wasCalled();
    assertApi('gtmOnFailure').wasNotCalled();
- name: Outra conta já está aguardando carregamento
  code: |-
    globals.beonConfig = {
      accountId: 'outro-tenant',
      platform: input.platform,
      env: input.env,
      cookieDomain: input.cookieDomain
    };

    runCode(input);

    assertThat(commands).isEmpty();
    assertThat(loads).isEmpty();
    assertApi('setInWindow').wasNotCalled();
    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();
- name: Falha ao carregar o script
  code: |-
    failLoad = true;

    runCode(input);

    assertThat(loads).hasLength(1);
    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();
setup: |-
  const input = {
    accountId: 'tenant-teste',
    platform: 'vtex',
    env: 'production',
    cookieDomain: 'loja.exemplo.com'
  };

  const globals = {};
  const commands = [];
  const loads = [];
  let failLoad = false;

  mock('copyFromWindow', function (key) {
    return globals[key];
  });

  mock('setInWindow', function (key, value) {
    globals[key] = value;
    return true;
  });

  mock('getTimestampMillis', 123456789);

  mock('createArgumentsQueue', function () {
    return function (command, accountId, platform) {
      commands.push([command, accountId, platform]);
    };
  });

  mock('injectScript', function (url, onSuccess, onFailure, cacheToken) {
    loads.push({ url: url, cacheToken: cacheToken });

    if (failLoad) {
      onFailure();
    } else {
      onSuccess();
    }
  });

  mock('logToConsole', function () {});


