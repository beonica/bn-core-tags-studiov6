___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const copyFromWindow = require('copyFromWindow');
const setInWindow = require('setInWindow');
const createArgumentsQueue = require('createArgumentsQueue');
const getTimestampMillis = require('getTimestampMillis');
const injectScript = require('injectScript');
const log = require('logToConsole');

const accountId = data.accountId;
const platform = data.platform;
const env = data.env || 'production';
const cookieDomain = data.cookieDomain || '';

function fail(message) {
  log('[Beonly] ' + message);
  data.gtmOnFailure();
}

function matchesConfig(config) {
  return config &&
    config.accountId === accountId &&
    config.platform === platform &&
    config.env === env &&
    config.cookieDomain === cookieDomain;
}

// Valida os campos antes de modificar os globais.
if (
  typeof accountId !== 'string' ||
  !accountId ||
  typeof platform !== 'string' ||
  !platform ||
  typeof cookieDomain !== 'string'
) {
  fail('Configuração inválida: confira conta, plataforma e domínio.');
  return;
}

if (env !== 'production' && env !== 'staging') {
  fail('Ambiente inválido. Use production ou staging.');
  return;
}

// Preserva integrações que já usam outro nome global.
const existingName = copyFromWindow('beonobject');

if (existingName !== undefined && existingName !== 'beon') {
  fail('Já existe uma integração com outro nome global.');
  return;
}

// Lê somente os campos necessários, sem copiar a engine inteira.
const coreVersion = copyFromWindow('beonly._coreVersion');

if (coreVersion === 6) {
  const runtimeConfig = {
    accountId: copyFromWindow('beonly.account'),
    platform: copyFromWindow('beonly.platform'),
    env: copyFromWindow('beonly.env'),
    cookieDomain: copyFromWindow('beonly.cookiedomain')
  };

  if (
    copyFromWindow('beonly.inited') === true &&
    matchesConfig(runtimeConfig)
  ) {
    data.gtmOnSuccess();
  } else {
    fail('A runtime existente não está inicializada com esta configuração.');
  }

  return;
}

// Evita carregar v6 sobre outra runtime já inicializada.
if (
  coreVersion !== undefined ||
  copyFromWindow('beone.inited') === true
) {
  fail('Já existe outra runtime Beonly nesta página.');
  return;
}

const existingBeon = copyFromWindow('beon');

if (existingBeon !== undefined && typeof existingBeon !== 'function') {
  fail('window.beon já existe e não é uma função compatível.');
  return;
}

// Também confere conflitos enquanto o loader ainda está baixando.
const pendingConfig = copyFromWindow('beonConfig');

if (pendingConfig && !matchesConfig(pendingConfig)) {
  fail('Já existe um carregamento com outra configuração.');
  return;
}

setInWindow('beonobject', 'beon', false);

// Equivalente ao stub: beon.q.push(arguments).
const beon = createArgumentsQueue('beon', 'beon.q');

setInWindow('beon.l', getTimestampMillis(), false);

// A primeira execução registra a configuração e enfileira create.
if (!pendingConfig) {
  const configured = setInWindow('beonConfig', {
    accountId: accountId,
    platform: platform,
    env: env,
    cookieDomain: cookieDomain
  }, false);

  if (!configured) {
    fail('Não foi possível registrar window.beonConfig.');
    return;
  }

  beon('create', accountId, platform);
}

const scriptUrl = env === 'staging'
  ? 'https://c.staging.usebeon.io/v6/loader.js'
  : 'https://c.usebeon.io/v6/loader.js';

injectScript(
  scriptUrl,
  function () {
    // Confirma carregamento do script, não entrega de rastreamento.
    data.gtmOnSuccess();
  },
  function () {
    fail('Falha ao carregar o loader: ' + scriptUrl);
  },
  scriptUrl
);


